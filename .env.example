# MemberDesk CRM - runtime settings. Copied to .env automatically on first run
# (with a random SECRET_KEY and ADMIN_PASSWORD). Never commit .env.

SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Branding shown in the app
ORG_NAME=Northbridge Professional Association
ORG_SHORT=Northbridge (Metro Chapter)

# Annual subscription fee used to mark members Paid / Not Paid
SUBSCRIPTION_FEE=2000

# ---- Email (SMTP) - leave blank until ready. Gmail: smtp.gmail.com / 587 + App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---- WhatsApp Cloud API (Meta) - leave blank to use click-to-chat (wa.me) links
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
DEFAULT_COUNTRY_CODE=91

# ---- Safety limits
MAX_SEND_PER_BATCH=25
MAX_SEND_PER_DAY=200
BACKUP_KEEP=50
